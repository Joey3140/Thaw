# === Harness-injected (private to local machine) ===
# Harness ownership manifest is tracked; everything else in
# .claude/ stays ignored. `.claude/*` rather than `.claude/`
# because git will not descend into an excluded directory,
# so a negation under `.claude/` has no effect.
.claude/*
!.claude/.harness-manifest
.codex/
.agents/
.husky/
.ai-codex/
.harness-version
codex-config.json
dashboard.html
*.pre-harness
*.pre-update
__tests__/golden/
tools/dashboard.html
tools/serve-dashboard.sh
tools/ticket-dashboard.js
scripts/build-codex.js
scripts/env-backup.sh
scripts/golden-capture.js
scripts/golden-compare.js
scripts/sync-session-state.sh
tests/e2e/
project/CLAUDE.md
project/SESSION_STATE.md
project/sessions/
project/sprints/
project/tickets/
# === End Harness-injected ===

# Secrets — auto-added by Harness
.env
.env.*
.env.local
.env.*.local
